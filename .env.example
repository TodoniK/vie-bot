# URL du webhook Discord (obligatoire)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Clé X-API-KEY requise par l'API Business France (obligatoire)
# À récupérer : ouvrir le Network tab du navigateur sur
# https://mon-vie-via.businessfrance.fr/offres/recherche, repérer une requête
# POST vers /api/Offers/search et copier le header X-API-KEY.
# ⚠️ Cette clé est embarquée dans le bundle JS du site et peut changer si
# Business France redéploie son frontend (surveiller les alertes Discord 401).
CIVIWEB_API_KEY=xxx

# Intervalle entre chaque vérification (secondes, défaut: 60)
# CHECK_INTERVAL=60

# Nombre max d'offres à récupérer (défaut: 5000)
# SEARCH_LIMIT=5000

# Niveau de log: DEBUG, INFO, WARNING, ERROR (défaut: INFO)
# LOG_LEVEL=INFO
