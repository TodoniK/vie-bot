# URL du webhook Discord (obligatoire)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Clé X-API-KEY de l'API Business France (facultatif) : par défaut le bot la lit
# dans la page publique mon-vie-via.businessfrance.fr et la relit seul sur 401/403.
# CIVIWEB_API_KEY=

# Critères (listes séparées par des virgules, ajoutées aux listes de classify.py)
# IT_COUNTRIES=US,CA,AU,NZ,PH,TH,VN,SG,MY,ID,KH,LA,MM,BN
# IT_EXTRA_KEYWORDS=platform engineer,kubernetes
# HR_EXTRA_KEYWORDS=
# EXCLUDE_EXTRA_KEYWORDS=

# Intervalle entre chaque vérification (secondes, défaut: 60)
# CHECK_INTERVAL=60

# Nombre max d'offres à récupérer (défaut: 5000)
# SEARCH_LIMIT=5000

# Niveau de log: DEBUG, INFO, WARNING, ERROR (défaut: INFO)
# LOG_LEVEL=INFO
